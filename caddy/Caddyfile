# Reverse proxy OVH — TLS Let's Encrypt, Ollama jamais public sans clé.
# Matchers : https://caddyserver.com/docs/caddyfile/matchers
# reverse_proxy : https://caddyserver.com/docs/caddyfile/directives/reverse_proxy

{
	email {$ACME_EMAIL}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
}

# API Ollama pour Blueseatra / Render. Exige X-Api-Key.
{$PUBLIC_DOMAIN} {
	import security_headers

	@authorized {
		header X-Api-Key {$OLLAMA_API_KEY}
	}

	@unauthorized {
		not header X-Api-Key {$OLLAMA_API_KEY}
	}

	respond @unauthorized "Unauthorized" 401

	reverse_proxy @authorized ollama:11434 {
		header_up Host {upstream_hostport}
		flush_interval -1
	}
}

# n8n — UI + webhooks. Compte owner créé au premier accès (ne pas exposer sans HTTPS).
{$N8N_HOST} {
	import security_headers

	reverse_proxy n8n:5678 {
		flush_interval -1
	}
}

# Hermes Agent gateway (orchestration). Même clé API que Ollama.
{$HERMES_HOST} {
	import security_headers

	@authorized {
		header X-Api-Key {$OLLAMA_API_KEY}
	}

	@unauthorized {
		not header X-Api-Key {$OLLAMA_API_KEY}
	}

	respond @unauthorized "Unauthorized" 401

	reverse_proxy @authorized hermes:8642 {
		header_up Host {upstream_hostport}
		flush_interval -1
	}
}
