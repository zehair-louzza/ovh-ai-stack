# Reverse proxy OVH — TLS Let's Encrypt, Ollama jamais public sans clé.
# Matchers : https://caddyserver.com/docs/caddyfile/matchers
# reverse_proxy : https://caddyserver.com/docs/caddyfile/directives/reverse_proxy

{
	email {$ACME_EMAIL}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
}

# API Ollama pour Blueseatra / Render. Exige X-Api-Key.
{$PUBLIC_DOMAIN} {
	import security_headers

	@authorized {
		header X-Api-Key {$OLLAMA_API_KEY}
	}

	@unauthorized {
		not header X-Api-Key {$OLLAMA_API_KEY}
	}

	respond @unauthorized "Unauthorized" 401

	reverse_proxy @authorized ollama:11434 {
		header_up Host {upstream_hostport}
		flush_interval -1
	}
}

# n8n — UI + webhooks. Compte owner créé au premier accès (ne pas exposer sans HTTPS).
{$N8N_HOST} {
	import security_headers

	reverse_proxy n8n:5678 {
		flush_interval -1
	}
}

# hermes.blueseatra.com — deux accès sur le même nom (29/09/2026) :
#  1. Machines (API Blueseatra sur Render) : en-tête X-Api-Key = OLLAMA_API_KEY
#     -> passerelle Hermès sans outils (hermes-passerelle:8642). Caddy injecte
#     le Bearer API_SERVER_KEY attendu par Hermès (ADR-004).
#  2. Navigateur : identifiant + mot de passe (basic_auth, hachage bcrypt en
#     base64 dans .env, généré par scripts/activer-hermes.sh), puis page de
#     connexion du tableau de bord de l'agent principal (hermes:9119).
{$HERMES_HOST} {
	import security_headers

	@machine header X-Api-Key *
	handle @machine {
		@unauthorized not header X-Api-Key {$OLLAMA_API_KEY}
		respond @unauthorized "Unauthorized" 401
		reverse_proxy hermes-passerelle:8642 {
			header_up Host {upstream_hostport}
			header_up Authorization "Bearer {$API_SERVER_KEY}"
			header_up -X-Api-Key
			flush_interval -1
		}
	}

	handle {
		basic_auth {
			{$HERMES_WEB_USER} {$HERMES_WEB_HASH}
		}
		reverse_proxy hermes:9119 {
			flush_interval -1
		}
	}
}
