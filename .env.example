# =============================================================================
# ovh-ai-stack — secrets et paramètres publics
# Copier vers .env sur le VPS :  cp .env.example .env
# Ne jamais committer .env
# =============================================================================

# --- Domaine public (enregistrement DNS A vers 162.19.44.2) ---
# Exemple : ia.blueseatra.com
PUBLIC_DOMAIN=ia.example.com
N8N_HOST=n8n.example.com
HERMES_HOST=hermes.example.com
ACME_EMAIL=contact@example.com

# --- Clé API Ollama (Render / Blueseatra -> Caddy) ---
# Générer : openssl rand -hex 32
OLLAMA_API_KEY=change-me-ollama-api-key

# --- n8n ---
# Générer : openssl rand -hex 32
N8N_ENCRYPTION_KEY=change-me-n8n-encryption-key
GENERIC_TIMEZONE=Europe/Paris

# --- Hermes Agent (pointe uniquement vers Ollama local) ---
# Ollama n'exige pas de vraie clé ; valeur factice obligatoire pour le client OpenAI.
OPENAI_BASE_URL=http://ollama:11434/v1
OPENAI_API_KEY=ollama-local
HERMES_MODEL=qwen3.6:27b

# --- Modèle Ollama par défaut pour Blueseatra ---
# hermes3 = nom officiel Ollama (alias hermes-3 créé par scripts/pull-models.sh)
OLLAMA_DEFAULT_MODEL=hermes3
OLLAMA_PRIMARY_MODEL=qwen3.6:27b
OLLAMA_FALLBACK_MODEL=qwen2.5:14b
